# ─── IronLink Backend — Variables de Entorno ───
# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:tu_password@localhost:5432/IronLink

# Secreto para firmar tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=tu_secreto_jwt_super_seguro_cambiar_en_produccion

# Configuración SMTP (Gmail con contraseña de aplicación)
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM="IronLink <tu_correo@gmail.com>"
